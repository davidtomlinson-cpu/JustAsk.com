# Copy this to .env (or set these as real environment variables) before
# running the app. See README.md for the full explanation of each one.

# Required
DATABASE_URL=postgresql://memorymaker:memorymaker_dev@localhost:5432/memorymaker_dev

# Optional
PORT=3100
PGSSL=
PUBLIC_BASE_URL=

# SMS reminders (Twilio) — leave unset to run with SMS switched off
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# AI recipe generation (Claude) — leave unset to run with it switched off
ANTHROPIC_API_KEY=

# Google Calendar sync — leave both unset to run with it switched off.
# Create an OAuth client (type "Web application") in Google Cloud Console,
# enable the Calendar API, and add <PUBLIC_BASE_URL>/api/integrations/google/callback
# as an authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cron endpoints (POST /api/cron/sweep, POST /api/cron/daily-summary) —
# leave unset to disable both
CRON_SECRET=
